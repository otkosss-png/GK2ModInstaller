<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>GK2Publisher</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GameDir Condition="'$(GameDir)' == ''">E:\SteamLibrary\steamapps\common\Graveyard Keeper 2</GameDir>
    <SteamworksDll>$(GameDir)\GraveyardKeeper2_Data\Managed\com.rlabrecque.steamworks.net.dll</SteamworksDll>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Steamworks.NET"><HintPath>$(SteamworksDll)</HintPath><Private>true</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <None Include="$(GameDir)\GraveyardKeeper2_Data\Plugins\x86_64\steam_api64.dll" Link="steam_api64.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="steam_appid.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
